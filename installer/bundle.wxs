<!--
  ext4easy-setup.exe (WiX Toolset v5 bundle): installs WinFsp, then ext4easy.
  Variables: Version, WinFspMsi, Ext4easyMsi.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal">
  <Bundle Name="ext4easy"
          Version="$(Version)"
          Manufacturer="ext4easy project"
          UpgradeCode="42228CE3-1F13-457C-A7C2-DA53449719DB"
          IconSourceFile="..\res\ext4easy.ico">

    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication
          Theme="hyperlinkLicense"
          LicenseUrl="https://www.gnu.org/licenses/gpl-3.0.html"
          LogoFile="..\res\ext4easy-64.png"
          LaunchTarget="[ProgramFiles64Folder]ext4easy\ext4easy-tray.exe"
          SuppressOptionsUI="yes" />
    </BootstrapperApplication>

    <Chain>
      <!-- Permanent: other programs may use WinFsp too, so uninstalling
           ext4easy leaves it in place. If a newer WinFsp is already
           installed, Burn skips this package. -->
      <MsiPackage SourceFile="$(WinFspMsi)" Permanent="yes" Visible="yes" />

      <MsiPackage SourceFile="$(Ext4easyMsi)">
        <!-- the bundle is the entry in "Apps & features", not the MSI -->
        <MsiProperty Name="ARPSYSTEMCOMPONENT" Value="1" />
      </MsiPackage>
    </Chain>
  </Bundle>
</Wix>
